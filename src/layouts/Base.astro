---
import '../styles/global.css';
import { SITE, NAV, PERFIS, MODULOS, FOTOS, slugModulo } from '../config';

interface Props {
  titulo?: string;
  descricao?: string;
  imagem?: string;
  tipo?: 'website' | 'article';
  semIndice?: boolean;
}
const { titulo, descricao = SITE.descricao, imagem = '/compartilhar.png', tipo = 'website', semIndice = false } = Astro.props;
const tituloCompleto = titulo ? `${titulo} | ${SITE.nome}` : `${SITE.nome} | Gestão de incorporadoras e construtoras`;
// Endereço oficial da página, sem o ".html" do final.
const caminho = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const canonica = new URL(caminho, SITE.url).href;
const imagemUrl = new URL(imagem, SITE.url).href;
const zap = SITE.whatsapp ? `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent('Olá! Quero conhecer a Incorion.')}` : '';
const autores = [...new Set(Object.values(FOTOS).map((f) => f.autor))].join(', ');
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonica} />
    {semIndice && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0E1A33" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content={SITE.nome} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagemUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Instrument+Sans:wght@400;500;600&display=swap" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <slot name="head" />
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <header class="topo">
      <div class="recorte barra">
        <a href="/" class="marca" aria-label="Incorion, página inicial">
          <img src="/marca/incorion-logo-horizontal-transparente-para-fundo-claro.svg" alt="Incorion" width="662" height="216" />
        </a>
        <button class="menu-botao" type="button" aria-expanded="false" aria-controls="menu" aria-label="Abrir menu">
          <span></span><span></span><span></span>
        </button>
        <nav class="menu" id="menu" aria-label="Principal">
          <ul class="menu-lista">
            {NAV.map((item) => (
              item.sub ? (
                <li class="tem-sub">
                  <button type="button" class="menu-item" aria-expanded="false">{item.label}<svg viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2"/></svg></button>
                  <ul class="sub">
                    {item.sub.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
                  </ul>
                </li>
              ) : (
                <li><a class="menu-item" href={item.href} aria-current={caminho === item.href ? 'page' : undefined}>{item.label}</a></li>
              )
            ))}
          </ul>
          <a class="botao" href="/#contato">Solicite uma demonstração</a>
        </nav>
      </div>
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <footer class="rodape">
      <div class="recorte">
        <div class="rodape-grade">
          <div class="rodape-marca">
            <img src="/marca/incorion-logo-horizontal-transparente-para-fundo-escuro.svg" alt="Incorion" width="662" height="216" loading="lazy" />
            <p>{SITE.slogan} Gestão para incorporadoras e construtoras, do terreno às chaves.</p>
            <a class="botao" href="/#contato">Solicite uma demonstração</a>
          </div>
          <div>
            <p class="rodape-titulo">Soluções</p>
            <ul>{MODULOS.map((m) => <li><a href={`/modulos/${slugModulo(m.nome)}`}>{m.nome}</a></li>)}</ul>
          </div>
          <div>
            <p class="rodape-titulo">Para quem</p>
            <ul>{PERFIS.map((p) => <li><a href={`/${p.slug}`}>{p.nome}</a></li>)}</ul>
            <p class="rodape-titulo segundo">Incorion</p>
            <ul>
              <li><a href="/leo">Leo IA</a></li>
              <li><a href="/blog">Blog</a></li>
              <li><a href="/#faq">Perguntas frequentes</a></li>
            </ul>
          </div>
          <div>
            <p class="rodape-titulo">Contato</p>
            <ul>
              <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
              {zap && <li><a href={zap} target="_blank" rel="noopener">WhatsApp</a></li>}
              <li><a href="/#contato">Solicite uma demonstração</a></li>
            </ul>
          </div>
        </div>
        <div class="rodape-meta">
          <p>© {new Date().getFullYear()} Incorion. Todos os direitos reservados.</p>
          <p>Fotos: {autores}, via Unsplash.</p>
        </div>
      </div>
    </footer>

    {zap && (
      <a class="zap" href={zap} target="_blank" rel="noopener" aria-label="Falar no WhatsApp">
        <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 3C9 3 3.3 8.6 3.3 15.6c0 2.4.7 4.7 1.9 6.7L3 29l6.9-2.1c1.9 1 4 1.6 6.1 1.6 7 0 12.7-5.7 12.7-12.7S23 3 16 3zm0 23.2c-1.9 0-3.8-.5-5.4-1.5l-.4-.2-4.1 1.2 1.2-4-.3-.4c-1.1-1.7-1.7-3.6-1.7-5.6C5.3 9.8 10.1 5 16 5s10.7 4.8 10.7 10.6S21.9 26.2 16 26.2zm5.9-7.9c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.2-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.3.3-.6.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.5c.2.2 2.4 3.6 5.8 5 2.8 1.1 3.4.9 4 .8.6-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5-.1-.2-.3-.3-.6-.4z"/></svg>
        <span>Falar no WhatsApp</span>
      </a>
    )}

    <script is:inline>
      (() => {
        const botao = document.querySelector('.menu-botao');
        const menu = document.getElementById('menu');
        botao.addEventListener('click', () => {
          const aberto = botao.getAttribute('aria-expanded') !== 'true';
          botao.setAttribute('aria-expanded', String(aberto));
          menu.classList.toggle('aberto', aberto);
          document.body.classList.toggle('travado', aberto);
        });
        menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => {
          botao.setAttribute('aria-expanded', 'false'); menu.classList.remove('aberto'); document.body.classList.remove('travado');
        }));
        document.querySelectorAll('.tem-sub > button').forEach((b) => {
          b.addEventListener('click', (e) => {
            e.stopPropagation();
            const aberto = b.getAttribute('aria-expanded') !== 'true';
            document.querySelectorAll('.tem-sub > button').forEach((x) => x.setAttribute('aria-expanded', 'false'));
            b.setAttribute('aria-expanded', String(aberto));
          });
        });
        document.addEventListener('click', () => document.querySelectorAll('.tem-sub > button').forEach((x) => x.setAttribute('aria-expanded', 'false')));
      })();
    </script>
    <script is:inline src="/js/movimento.js" defer></script>
  </body>
</html>

<style>
  .pular { position: absolute; left: 16px; top: -60px; z-index: 30; background: var(--branco); color: var(--noite); padding: 12px 16px; }
  .pular:focus { top: 12px; }

  .topo { position: sticky; top: 0; z-index: 20; background: rgba(255, 255, 255, .97); color: var(--noite); box-shadow: 0 1px 0 rgba(14, 26, 51, .08); }
  .barra { display: flex; align-items: center; gap: 24px; min-height: 76px; }
  .marca img { width: 136px; }
  .menu { display: flex; align-items: center; gap: 28px; margin-left: auto; }
  .menu-lista { list-style: none; display: flex; align-items: center; gap: 4px; margin: 0; padding: 0; }
  .menu-item { display: inline-flex; align-items: center; gap: 6px; padding: 10px 12px; border-radius: 8px; border: 0; background: none; font: 500 1rem var(--f-texto); color: var(--noite); text-decoration: none; cursor: pointer; transition: background-color var(--mov), color var(--mov); }
  .menu-item:hover, .menu-item[aria-current='page'] { background: var(--concreto); }
  .menu-item svg { width: 11px; transition: transform var(--mov); }
  .tem-sub { position: relative; }
  .sub { list-style: none; margin: 0; padding: 8px; position: absolute; top: calc(100% + 6px); left: 0; min-width: 240px; background: var(--branco); border-radius: 12px; box-shadow: 0 18px 40px rgba(14, 26, 51, .16); opacity: 0; transform: translateY(-6px); pointer-events: none; transition: opacity var(--mov), transform var(--mov); }
  .sub a { display: block; padding: 10px 12px; border-radius: 8px; text-decoration: none; transition: background-color var(--mov); }
  .sub a:hover { background: var(--concreto); color: var(--cobalto-texto); }
  .tem-sub > button[aria-expanded='true'] + .sub { opacity: 1; transform: none; pointer-events: auto; }
  .tem-sub > button[aria-expanded='true'] svg { transform: rotate(180deg); }
  @media (hover: hover) and (min-width: 1081px) {
    .tem-sub:hover .sub, .tem-sub:focus-within .sub { opacity: 1; transform: none; pointer-events: auto; }
  }
  .topo .botao { min-height: 46px; padding: 0 20px; }
  .menu-botao { display: none; margin-left: auto; width: 48px; height: 48px; border: 0; background: none; cursor: pointer; flex-direction: column; justify-content: center; align-items: center; gap: 5px; }
  .menu-botao span { width: 24px; height: 2px; background: var(--noite); transition: transform var(--mov), opacity var(--mov); }
  .menu-botao[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu-botao[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .menu-botao[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 1080px) {
    .menu-botao { display: flex; }
    .menu { position: fixed; inset: 76px 0 0 0; background: var(--branco); flex-direction: column; align-items: stretch; gap: 24px; padding: 16px var(--margem) 32px; overflow-y: auto; opacity: 0; pointer-events: none; transform: translateY(-8px); transition: opacity var(--mov), transform var(--mov); }
    .menu.aberto { opacity: 1; pointer-events: auto; transform: none; }
    .menu-lista { flex-direction: column; align-items: stretch; gap: 0; }
    .menu-item { width: 100%; justify-content: space-between; padding: 16px 4px; font-size: 1.125rem; border-radius: 0; }
    .menu-item:hover { background: none; }
    .sub { position: static; box-shadow: none; padding: 0 0 8px 12px; min-width: 0; display: none; opacity: 1; transform: none; pointer-events: auto; }
    .tem-sub > button[aria-expanded='true'] + .sub { display: block; }
    .menu .botao { width: 100%; }
  }
  :global(body.travado) { overflow: hidden; }

  .rodape { background: var(--noite); color: var(--branco); padding-block: 80px 28px; }
  .rodape-grade { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 40px; }
  .rodape-marca img { width: 140px; }
  .rodape-marca p { margin-top: 18px; color: var(--suave-escuro); max-width: 32ch; }
  .rodape-marca .botao { margin-top: 24px; }
  .rodape-titulo { font: 600 1rem var(--f-titulo); margin-bottom: 14px; }
  .rodape-titulo.segundo { margin-top: 28px; }
  .rodape ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .rodape ul a { color: var(--suave-escuro); text-decoration: none; transition: color var(--mov); }
  .rodape ul a:hover { color: var(--branco); }
  .rodape-meta { margin-top: 64px; padding-top: 24px; box-shadow: inset 0 1px 0 rgba(255, 255, 255, .1); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; font-size: var(--t-pequeno); color: var(--suave-escuro); }
  @media (max-width: 900px) {
    .rodape-grade { grid-template-columns: 1fr 1fr; }
    .rodape-marca { grid-column: span 2; }
  }
  @media (max-width: 520px) {
    .rodape-grade { grid-template-columns: 1fr; }
    .rodape-marca { grid-column: auto; }
  }

  .zap { position: fixed; right: 20px; bottom: 20px; z-index: 25; display: inline-flex; align-items: center; gap: 10px; padding: 0 20px 0 16px; min-height: 56px; border-radius: 99px; background: #1FAF58; color: #fff; font-weight: 600; text-decoration: none; box-shadow: 0 10px 30px rgba(14, 26, 51, .25); transition: transform var(--mov); }
  .zap:hover { transform: translateY(-2px); }
  .zap svg { width: 26px; height: 26px; }
  @media (max-width: 560px) { .zap span { display: none; } .zap { padding: 0; width: 56px; justify-content: center; } }
</style>
