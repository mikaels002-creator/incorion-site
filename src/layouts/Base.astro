---
import '../styles/global.css';
import { SITE, NAV } from '../config';

interface Props {
  titulo?: string;
  descricao?: string;
  imagem?: string;
  tipo?: 'website' | 'article';
}
const { titulo, descricao = SITE.descricao, imagem = '/compartilhar.png', tipo = 'website' } = Astro.props;
const tituloCompleto = titulo ? `${titulo} | ${SITE.nome}` : `${SITE.nome} | Gestão de incorporadoras`;
// Endereço oficial da página, sem o ".html" do final.
const caminho = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const canonica = new URL(caminho, SITE.url).href;
const imagemUrl = new URL(imagem, SITE.url).href;
const aqui = caminho;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonica} />
    <meta name="theme-color" content="#0E1A33" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content={SITE.nome} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagemUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Instrument+Sans:wght@400;500;600&display=swap"
    />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <slot name="head" />
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <header class="topo">
      <div class="recorte barra">
        <a href="/" class="marca" aria-label="Incorion, página inicial">
          <img src="/marca/incorion-logo-horizontal-transparente-para-fundo-escuro.svg" alt="Incorion" width="662" height="216" />
        </a>
        <nav aria-label="Principal">
          <ul>
            {NAV.map((item) => (
              <li><a href={item.href} aria-current={aqui === item.href ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
        <a class="botao" href="/#lista-de-espera">Lista de espera</a>
      </div>
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <footer class="rodape" id="contato">
      <div class="recorte rodape-caixa">
        <div class="rodape-topo">
          <img class="rodape-marca" src="/marca/incorion-logo-horizontal-transparente-para-fundo-escuro.svg" alt="Incorion" width="662" height="216" loading="lazy" />
          <p>Gestão para incorporadoras e construtoras, do terreno às chaves.</p>
          <p>Fale com a gente por e-mail.</p>
          <a class="rodape-subir" href="#conteudo">Voltar ao topo</a>
        </div>
        <a class="rodape-email" href={`mailto:${SITE.email}`}><span>contato</span><span>@incorion.com.br</span></a>
        <div class="rodape-meta">
          <ul>
            <li><a href="/#plataforma">Plataforma</a></li>
            <li><a href="/#leo">Leo</a></li>
            <li><a href="/blog">Blog</a></li>
            <li><a href="/#lista-de-espera">Lista de espera</a></li>
          </ul>
          <p>© {new Date().getFullYear()} Incorion</p>
          <p>Brasil</p>
        </div>
      </div>
    </footer>
    <script is:inline src="/js/movimento.js" defer></script>
  </body>
</html>

<style>
  .pular { position: absolute; left: 16px; top: -60px; z-index: 10; background: var(--branco); color: var(--noite); padding: 12px 16px; }
  .pular:focus { top: 12px; }

  .topo { background: var(--noite); color: var(--branco); position: relative; z-index: 5; }
  .barra { display: flex; align-items: center; gap: 32px; min-height: 76px; }
  .marca img { width: 132px; }
  nav { margin-left: auto; }
  nav ul { list-style: none; display: flex; gap: 28px; margin: 0; padding: 0; }
  nav a { text-decoration: none; font-weight: 500; color: var(--suave-escuro); transition: color var(--mov); }
  nav a:hover, nav a[aria-current='page'] { color: var(--branco); }
  .topo .botao { min-height: 44px; padding: 0 20px; }

  @media (max-width: 720px) {
    .barra { gap: 16px; min-height: 64px; }
    .marca img { width: 112px; }
    nav ul { gap: 16px; }
    nav li:nth-child(2) { display: none; }
    .topo .botao { display: none; }
  }

  .rodape { background: var(--noite); color: var(--branco); }
  .rodape-caixa { min-height: 90svh; display: flex; flex-direction: column; padding-block: 40px 28px; }
  .rodape-topo { display: grid; grid-template-columns: auto 1fr 1fr auto; gap: 24px 40px; align-items: start; font-size: var(--t-pequeno); }
  .rodape-marca { width: 112px; }
  .rodape-topo a, .rodape-meta a { text-decoration: none; transition: color var(--mov); }
  .rodape-subir:hover, .rodape-meta a:hover { color: var(--leo); }
  .rodape-email {
    margin-top: auto; display: flex; flex-wrap: wrap; text-decoration: none;
    font-family: var(--f-titulo); font-weight: 700; letter-spacing: -0.05em; line-height: .95;
    font-size: var(--t-hero); transition: color var(--mov);
  }
  .rodape-email:hover { color: var(--cobalto); }
  .rodape-meta { margin-top: 40px; display: grid; grid-template-columns: 1fr auto 1fr; gap: 12px 24px; font-size: var(--t-pequeno); }
  .rodape-meta ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .rodape-meta p:last-child { text-align: right; }
  @media (max-width: 720px) {
    .rodape-topo { grid-template-columns: 1fr; }
    .rodape-email { font-size: 12.5vw; flex-direction: column; }
    .rodape-meta { grid-template-columns: 1fr; }
    .rodape-meta p:last-child { text-align: left; }
  }
</style>
