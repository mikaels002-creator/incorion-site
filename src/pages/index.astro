---
import Base from '../layouts/Base.astro';
import { SITE, MODULOS, MODULO_CORRETORES } from '../config';

// Espelho de vendas ILUSTRATIVO: Residencial Aurora, Torre A, 8 andares x 4 unidades.
const vendidas = ['801','803','704','804','604','601','603','503','502','401','404','402','304','303','204','202','201','104','101'];
const reservadas = ['802','703','504','301'];
const unidades = [];
for (let andar = 8; andar >= 1; andar--) {
  for (let final = 1; final <= 4; final++) {
    const id = `${andar}0${final}`;
    const canto = final === 1 || final === 4;
    const area = canto ? 92 : 74;
    const preco = (canto ? 742000 : 598000) + andar * 14000;
    const status = vendidas.includes(id) ? 'vendida' : reservadas.includes(id) ? 'reservada' : 'livre';
    unidades.push({ id, area, preco, status });
  }
}
const brl = (n) => n.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 });
const livres = unidades.filter((u) => u.status === 'livre');
const valorLivre = livres.reduce((s, u) => s + u.preco, 0);
const primeiraLivre = livres.find((u) => u.id === '702') ? '702' : livres[0].id;

const pastas = [
  { href: '#leo', nome: 'O Leo', cor: 'var(--leo)', ink: 'var(--noite)', aba: '62%' },
  { href: '#plataforma', nome: 'Módulos', cor: 'var(--branco)', ink: 'var(--noite)', aba: '10%' },
  { href: '#um-boleto', nome: 'Um boleto', cor: 'var(--cobalto-texto)', ink: 'var(--branco)', aba: '76%' },
  { href: '#estoque', nome: 'O estoque', cor: 'var(--concreto)', ink: 'var(--noite)', aba: '30%' },
];
---
<Base>
  <section class="hero" aria-labelledby="hero-titulo">
    <div class="hero-texto">
      <h1 id="hero-titulo">Do terreno às chaves.</h1>
      <p>A incorporação inteira em uma plataforma. Com o Leo, a IA que trabalha no WhatsApp da sua incorporadora.</p>
    </div>
    <nav class="pastas" aria-label="Capítulos da página">
      {pastas.map((p, i) => (
        <a class="pasta" href={p.href} style={`--cor:${p.cor};--ink:${p.ink};--aba:${p.aba};--i:${i}`}>
          <span class="aba">{p.nome}</span>
        </a>
      ))}
      <div class="pasta frente" style="--cor:var(--cobalto-texto);--ink:var(--branco);--aba:44%;--i:4">
        <a class="aba" href="#lista-de-espera">Lista de espera</a>
        <a class="botao claro" href="#lista-de-espera">Entrar na lista de espera</a>
      </div>
    </nav>
  </section>

  <section class="virada" aria-labelledby="virada-titulo">
    <div class="painel painel-hoje">
      <h2 id="virada-titulo">Do caos ao controle.</h2>
      <div class="objeto" data-reveal>
        <div class="planilha" data-ui>
          <div class="planilha-nome">CONTAS OBRA v7 FINAL (2).xlsx</div>
          <table>
            <tr><th></th><th>A</th><th>B</th><th>C</th></tr>
            <tr><td>1</td><td>Fornecedor</td><td>Valor</td><td>Pago?</td></tr>
            <tr><td>2</td><td>Concreteira</td><td>18.400</td><td>ver no banco</td></tr>
            <tr><td>3</td><td>Aço CA-50</td><td>#REF!</td><td>?</td></tr>
            <tr><td>4</td><td>Locação andaime</td><td>3.250</td><td>sim (acho)</td></tr>
            <tr><td>5</td><td>Elétrica 2º pav</td><td>9.870</td><td>falta NF</td></tr>
            <tr><td>6</td><td>Boleto do grupo</td><td>—</td><td>quem mandou?</td></tr>
            <tr><td>7</td><td>Hidráulica</td><td>12.300</td><td></td></tr>
          </table>
        </div>
      </div>
      <div class="rodape-painel">
        <p><strong>Hoje</strong></p>
        <p>Planilha, grupo de WhatsApp e boleto perdido no e-mail.</p>
      </div>
    </div>
    <div class="painel painel-depois">
      <div class="objeto" data-reveal>
        <div class="lista-contas" data-ui>
          <div class="lc-topo"><span>Contas a pagar</span><span>Residencial Aurora</span></div>
          <div class="lc-linha"><span>Concreteira Vale Forte</span><span>R$ 18.400</span><span class="chip pago">Pago</span></div>
          <div class="lc-linha"><span>Aço CA-50 · 2,4 t</span><span>R$ 16.368</span><span class="chip aprovar">Aprovar</span></div>
          <div class="lc-linha"><span>Locação de andaime</span><span>R$ 3.250</span><span class="chip pago">Pago</span></div>
          <div class="lc-linha"><span>Elétrica · 2º pavimento</span><span>R$ 9.870</span><span class="chip nf">Nota anexada</span></div>
          <div class="lc-linha"><span>Hidráulica · prumadas</span><span>R$ 12.300</span><span class="chip agendado">28/10</span></div>
          <div class="lc-total"><span>Total do mês</span><span>R$ 60.188</span></div>
        </div>
      </div>
      <div class="rodape-painel">
        <p><strong>Na Incorion</strong></p>
        <p>Tudo lançado, aprovado e conferido com o extrato, no mesmo lugar.</p>
      </div>
    </div>
  </section>

  <section class="passos" id="um-boleto" aria-labelledby="passos-titulo">
    <div class="passo p1">
      <h2 id="passos-titulo">Um boleto, quatro passos.</h2>
      <div class="cartao-pos" data-reveal>
        <div class="cartao" data-ui>
          <div class="msg">
            <span class="quem">Mestre de obras · grupo Obra Aurora</span>
            <span class="anexo">boleto-concreteira.pdf</span>
            <span>Chegou o boleto da concretagem da 6ª laje.</span>
            <span class="hora">09:12</span>
          </div>
        </div>
      </div>
      <p class="clausula">Primeiro ele chega no grupo da obra.</p>
    </div>
    <div class="passo p2">
      <div class="cartao-pos" data-reveal>
        <div class="cartao" data-ui>
          <dl class="campos">
            <div><dt>Fornecedor</dt><dd>Concreteira Vale Forte</dd></div>
            <div><dt>Valor</dt><dd>R$ 18.400,00</dd></div>
            <div><dt>Vencimento</dt><dd>28/10/2026</dd></div>
            <div><dt>Obra</dt><dd>Residencial Aurora</dd></div>
            <div><dt>Etapa</dt><dd>Estrutura</dd></div>
          </dl>
          <span class="selo leo-selo">Lido pelo Leo</span>
        </div>
      </div>
      <p class="clausula">Depois o Leo lê e lança sozinho.</p>
    </div>
    <div class="passo p3">
      <div class="cartao-pos" data-reveal>
        <div class="cartao" data-ui>
          <div class="msg leo">
            <span class="quem">Leo</span>
            <span>3 contas para pagar hoje, total R$ 37.770. Autoriza?</span>
            <span class="resposta">Sim, pode pagar.</span>
          </div>
        </div>
      </div>
      <p class="clausula">Então você aprova pelo WhatsApp.</p>
    </div>
    <div class="passo p4">
      <div class="cartao-pos" data-reveal>
        <div class="cartao" data-ui>
          <dl class="campos">
            <div><dt>Concreteira Vale Forte</dt><dd>R$ 18.400,00</dd></div>
            <div><dt>Situação</dt><dd>Paga em 28/10</dd></div>
            <div><dt>Extrato</dt><dd>Conferido</dd></div>
            <div><dt>Comprovante</dt><dd>Anexado</dd></div>
          </dl>
          <span class="selo">Baixa feita</span>
        </div>
      </div>
      <p class="clausula">Por fim, a conta é baixada sozinha.</p>
    </div>
  </section>

  <section class="estoque" id="estoque" aria-labelledby="estoque-titulo">
    <div class="estoque-palco">
      <div class="espelho" data-ui id="espelho" data-filtro="todas">
        <div class="esp-topo">
          <span>Residencial Aurora · Torre A</span>
          <span class="esp-legenda"><i class="l-livre"></i>Livre <i class="l-reservada"></i>Reservada <i class="l-vendida"></i>Vendida</span>
        </div>
        <div class="esp-grade">
          {unidades.map((u) => (
            <button type="button" class={`un ${u.status}`} data-id={u.id} data-area={u.area} data-preco={u.preco} data-status={u.status} aria-label={`Unidade ${u.id}, ${u.status}`}>
              <span class="un-num">{u.id}</span>
              <span class="un-preco">{u.status === 'vendida' ? 'Vendida' : brl(u.preco)}</span>
            </button>
          ))}
        </div>
        <div class="esp-info" aria-live="polite">
          <span id="esp-detalhe">Toque numa unidade para ver os detalhes.</span>
          <span>Estoque livre: <strong id="esp-valor">{brl(valorLivre)}</strong></span>
        </div>
        <div class="esp-leo" id="esp-leo" hidden>
          <span class="quem">Leo</span>
          <span id="esp-leo-texto"></span>
        </div>
      </div>
    </div>
    <div class="estoque-texto">
      <h2 id="estoque-titulo">O estoque, ao vivo.</h2>
      <div class="bloco">
        <p class="frase-bloco">Veja cada unidade como ela está agora.</p>
        <p>O espelho de vendas se atualiza a cada venda e a cada reserva. Sem planilha mandada por e-mail.</p>
        <div class="segmentado" role="group" aria-label="Filtrar unidades">
          <button type="button" data-filtro="todas" aria-pressed="true">Todas</button>
          <button type="button" data-filtro="livre" aria-pressed="false">Livres</button>
          <button type="button" data-filtro="reservada" aria-pressed="false">Reservadas</button>
          <button type="button" data-filtro="vendida" aria-pressed="false">Vendidas</button>
        </div>
      </div>
      <div class="bloco">
        <p class="frase-bloco">Reajuste a tabela de uma vez.</p>
        <p>Mude o percentual e todas as unidades livres ganham o preço novo, na mesma hora.</p>
        <label class="controle-rotulo" for="reajuste">Reajuste da tabela: <strong id="reajuste-valor">0%</strong></label>
        <input type="range" id="reajuste" min="0" max="10" step="0.5" value="0" />
      </div>
      <div class="bloco">
        <p class="frase-bloco">O corretor parceiro reserva pelo celular.</p>
        <p>No {MODULO_CORRETORES}, cada corretor vê só o que está livre e reserva por 48 horas.</p>
        <form class="reserva" id="form-reserva">
          <label class="controle-rotulo" for="corretor">Nome do corretor</label>
          <div class="reserva-linha">
            <input type="text" id="corretor" value="Ana Paula" autocomplete="off" />
            <button type="submit" class="botao" id="btn-reserva">Reservar a {primeiraLivre}</button>
          </div>
        </form>
      </div>
      <div class="bloco">
        <p class="frase-bloco">O Leo avisa a equipe na hora.</p>
        <p>Cada reserva e cada venda chegam no WhatsApp de quem precisa saber.</p>
        <button type="button" class="chave" role="switch" aria-checked="false" id="avisar">
          <span class="chave-trilho"><span class="chave-bola"></span></span>
          <span>Avisar no WhatsApp</span>
        </button>
      </div>
    </div>
  </section>

  <section class="cap-leo" id="leo" aria-labelledby="leo-titulo">
    <div class="leo-texto">
      <h2 id="leo-titulo">O Leo está <span id="leo-palavra">de olho</span>.</h2>
      <p>Uma IA feita para o mercado imobiliário. Ele lê os grupos de WhatsApp da obra, lança as contas, cobra os prazos e avisa antes do problema chegar. Módulo à parte, contratado junto com a plataforma.</p>
    </div>
    <div class="leo-palco">
      <button type="button" class="leo-chave" data-ui role="switch" aria-checked="true" id="leo-chave" aria-label="Ligar ou desligar o Leo">
        <span class="lc-rotulo">Leo</span>
        <span class="lc-trilho"><span class="lc-bola"></span></span>
        <span class="lc-estado" id="leo-estado">Ligado</span>
      </button>
    </div>
  </section>

  <section class="modulos" id="plataforma" aria-labelledby="modulos-titulo">
    <div class="recorte">
      <h2 id="modulos-titulo">Cada etapa, um módulo.</h2>
      <p class="modulos-frase">Comece pelo que mais dói hoje e ligue os outros quando quiser. Tudo conversa entre si.</p>
      <div class="indice">
        <ul class="indice-lista">
          {MODULOS.map((m, i) => (
            <li class="indice-linha" data-i={i} tabindex="0" data-reveal>
              <span class="indice-nome">{m.nome}</span>
              <span class="indice-texto">{m.texto}</span>
              <div class="tela tela-inline" data-ui aria-hidden="true">
                <span class="tela-titulo">{m.tela}</span>
                {m.linhas.map(([a, b]) => <span class="tela-linha"><span>{a}</span><strong>{b}</strong></span>)}
              </div>
            </li>
          ))}
        </ul>
        <div class="indice-quadro" aria-hidden="true">
          <div class="quadro-fixo">
            {MODULOS.map((m, i) => (
              <div class={`tela ${i === 0 ? 'ativa' : ''}`} data-ui data-i={i}>
                <span class="tela-modulo">{m.nome}</span>
                <span class="tela-titulo">{m.tela}</span>
                {m.linhas.map(([a, b]) => <span class="tela-linha"><span>{a}</span><strong>{b}</strong></span>)}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="espera" id="lista-de-espera" aria-labelledby="espera-titulo">
    <div class="espera-fecho">
      <h2 id="espera-titulo">Entre na lista.</h2>
      <p>A Incorion abre em breve para as primeiras incorporadoras. Quem estiver na lista recebe o convite antes e conversa direto com a gente.</p>
    </div>
    <form class="dialogo" data-ui id="form-espera" novalidate>
      <p class="dlg-titulo">Lista de espera da Incorion</p>
      <div class="dlg-grade">
        <label>Nome<input name="nome" required autocomplete="name" placeholder="Seu nome" /></label>
        <label>Empresa<input name="empresa" required autocomplete="organization" placeholder="Nome da incorporadora" /></label>
        <label>Cargo<input name="cargo" autocomplete="organization-title" placeholder="Diretor, sócio, gerente..." /></label>
        <label>WhatsApp<input name="whatsapp" required type="tel" autocomplete="tel" placeholder="(47) 99999-0000" /></label>
        <label>E-mail<input name="email" required type="email" autocomplete="email" placeholder="voce@empresa.com.br" /></label>
        <label>Cidade<input name="cidade" autocomplete="address-level2" placeholder="Cidade, UF" /></label>
        <label class="dlg-largo">Obras em andamento<input name="obras" type="number" min="0" inputmode="numeric" placeholder="3" /></label>
      </div>
      <fieldset class="dlg-interesse">
        <legend>O que mais interessa</legend>
        <label><input type="radio" name="interesse" value="Incorion" checked /><span>A plataforma</span></label>
        <label><input type="radio" name="interesse" value="Leo" /><span>O Leo</span></label>
        <label><input type="radio" name="interesse" value="Corretores" /><span>Corretores</span></label>
      </fieldset>
      <p class="dlg-erro" id="dlg-erro" hidden>Preencha nome, empresa, WhatsApp e e-mail.</p>
      <button type="submit" class="dlg-botao">Quero entrar na lista</button>
    </form>
  </section>
</Base>

<script is:inline define:vars={{ email: SITE.email }}>
  const brl = (n) => n.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 });

  // ---- Espelho de vendas (a parte "ao vivo" da página) ----
  const espelho = document.getElementById('espelho');
  const unidades = [...espelho.querySelectorAll('.un')];
  const detalhe = document.getElementById('esp-detalhe');
  const valor = document.getElementById('esp-valor');
  const reajuste = document.getElementById('reajuste');
  const reajusteValor = document.getElementById('reajuste-valor');
  const leoBox = document.getElementById('esp-leo');
  const leoTexto = document.getElementById('esp-leo-texto');
  const avisar = document.getElementById('avisar');
  let fator = 1;
  let ultimoAviso = '';

  const precoAtual = (u) => Math.round(Number(u.dataset.preco) * fator / 1000) * 1000;
  function atualizarPrecos() {
    let total = 0;
    unidades.forEach((u) => {
      if (u.dataset.status === 'vendida') return;
      const p = precoAtual(u);
      u.querySelector('.un-preco').textContent = brl(p);
      if (u.dataset.status === 'livre') total += p;
    });
    valor.textContent = brl(total);
  }
  function avisarLeo(texto) {
    ultimoAviso = texto;
    if (avisar.getAttribute('aria-checked') === 'true') {
      leoTexto.textContent = texto;
      leoBox.hidden = false;
      leoBox.classList.remove('pulso'); void leoBox.offsetWidth; leoBox.classList.add('pulso');
    }
  }
  function mostrar(u) {
    unidades.forEach((x) => x.classList.toggle('sel', x === u));
    const extra = u.dataset.corretor ? ` por ${u.dataset.corretor}, vence em 48 h` : '';
    detalhe.textContent = `Unidade ${u.dataset.id} · ${u.dataset.area} m² · ${u.dataset.status}${extra}` + (u.dataset.status !== 'vendida' ? ` · ${brl(precoAtual(u))}` : '');
  }
  unidades.forEach((u) => u.addEventListener('click', () => mostrar(u)));

  document.querySelectorAll('.segmentado button').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('.segmentado button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    espelho.dataset.filtro = b.dataset.filtro;
  }));

  reajuste.addEventListener('input', () => {
    fator = 1 + Number(reajuste.value) / 100;
    reajusteValor.textContent = `${String(reajuste.value).replace('.', ',')}%`;
    atualizarPrecos();
    const sel = espelho.querySelector('.un.sel'); if (sel) mostrar(sel);
  });

  document.getElementById('form-reserva').addEventListener('submit', (e) => {
    e.preventDefault();
    const nome = (document.getElementById('corretor').value || 'Corretor parceiro').trim();
    const livre = unidades.find((u) => u.dataset.id === '702' && u.dataset.status === 'livre') || unidades.find((u) => u.dataset.status === 'livre');
    const btn = document.getElementById('btn-reserva');
    if (!livre) { btn.textContent = 'Sem unidades livres'; return; }
    livre.dataset.status = 'reservada'; livre.dataset.corretor = nome;
    livre.classList.remove('livre'); livre.classList.add('reservada', 'acabou');
    livre.setAttribute('aria-label', `Unidade ${livre.dataset.id}, reservada`);
    atualizarPrecos(); mostrar(livre);
    avisarLeo(`A ${livre.dataset.id} foi reservada por ${nome}. A reserva vence em 48 h.`);
    const prox = unidades.find((u) => u.dataset.status === 'livre');
    btn.textContent = prox ? `Reservar a ${prox.dataset.id}` : 'Sem unidades livres';
  });

  avisar.addEventListener('click', () => {
    const on = avisar.getAttribute('aria-checked') !== 'true';
    avisar.setAttribute('aria-checked', String(on));
    if (on) { avisarLeo(ultimoAviso || 'Avisos ligados. Cada reserva e cada venda da Torre A chegam no grupo Vendas Aurora.'); }
    else { leoBox.hidden = true; }
  });

  // ---- Chave do Leo ----
  const chave = document.getElementById('leo-chave');
  const secLeo = document.getElementById('leo');
  chave.addEventListener('click', () => {
    const on = chave.getAttribute('aria-checked') !== 'true';
    chave.setAttribute('aria-checked', String(on));
    secLeo.classList.toggle('desligado', !on);
    document.getElementById('leo-palavra').textContent = on ? 'de olho' : 'de folga';
    document.getElementById('leo-estado').textContent = on ? 'Ligado' : 'Desligado';
  });

  // ---- Índice de módulos com prévia ----
  const linhas = document.querySelectorAll('.indice-linha');
  const telas = document.querySelectorAll('.quadro-fixo .tela');
  const ativar = (i) => telas.forEach((t) => t.classList.toggle('ativa', t.dataset.i === i));
  linhas.forEach((l) => {
    l.addEventListener('mouseenter', () => ativar(l.dataset.i));
    l.addEventListener('focus', () => ativar(l.dataset.i));
  });

  // ---- Lista de espera (por enquanto abre um e-mail pronto; na etapa 3 grava no sistema) ----
  const form = document.getElementById('form-espera');
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = Object.fromEntries(new FormData(form));
    const erro = document.getElementById('dlg-erro');
    if (!d.nome || !d.empresa || !d.whatsapp || !d.email) { erro.hidden = false; return; }
    erro.hidden = true;
    const corpo = `Quero entrar na lista de espera da Incorion.\n\nNome: ${d.nome}\nEmpresa: ${d.empresa}\nCargo: ${d.cargo || ''}\nWhatsApp: ${d.whatsapp}\nE-mail: ${d.email}\nCidade: ${d.cidade || ''}\nObras em andamento: ${d.obras || ''}\nInteresse: ${d.interesse}\n`;
    location.href = `mailto:${email}?subject=${encodeURIComponent('Lista de espera Incorion: ' + d.empresa)}&body=${encodeURIComponent(corpo)}`;
  });
</script>

<style>
  /* ---------- Abertura: a torre de lajes vira uma pilha de pastas ---------- */
  .hero { background: var(--noite); color: var(--branco); min-height: calc(100svh - 76px); display: flex; flex-direction: column; overflow: hidden; }
  .hero-texto { text-align: center; padding: clamp(48px, 9vh, 104px) var(--margem) 0; }
  .hero h1 { font-size: var(--t-hero); line-height: .92; letter-spacing: -0.05em; font-weight: 700; }
  .hero-texto p { margin: 28px auto 0; max-width: 40ch; font-size: var(--t-lead); line-height: 1.45; }

  .pastas { position: relative; flex: 1; min-height: 46svh; margin-top: clamp(40px, 7vh, 80px); width: min(86vw, 1360px); margin-inline: auto; }
  .pasta { position: absolute; left: 0; right: 0; top: calc(var(--i) * 64px + 40px); bottom: -2px; background: var(--cor); color: var(--ink); text-decoration: none; }
  .aba {
    position: absolute; top: -40px; left: var(--aba); height: 40px; padding: 0 34px;
    display: inline-flex; align-items: center; background: var(--cor); color: var(--ink);
    font: 600 var(--t-texto)/1 var(--f-texto); white-space: nowrap; text-decoration: none;
    clip-path: polygon(18px 0, 100% 0, calc(100% - 18px) 100%, 0 100%);
  }
