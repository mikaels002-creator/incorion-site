---
import Base from '../layouts/Base.astro';
import Demonstracao from '../components/Demonstracao.astro';
import Plataforma from '../components/Plataforma.astro';
import { getCollection } from 'astro:content';
import { MODULOS, PERFIS, FAQ, FOTOS, foto, slugModulo } from '../config';

const posts = (await getCollection('blog', ({ data }) => !data.rascunho))
  .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf())
  .slice(0, 3);
const fmt = new Intl.DateTimeFormat('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' });
// Enquanto o blog não tem posts, mostra os próximos temas.
const proximos = [
  { href: '/blog', meta: 'Mercado e crédito · em breve', titulo: 'Além do banco: CRI, debênture e fundos financiando a incorporação', resumo: 'Como o mercado de capitais virou fonte de crédito para as incorporadoras e o que isso muda na sua obra.' },
  { href: '/blog', meta: 'Gestão · em breve', titulo: '5 sinais de que o caixa da obra fugiu do controle', resumo: 'Os sintomas mais comuns de um caixa desorganizado e como corrigir antes que vire problema.' },
  { href: '/blog', meta: 'Leo · em breve', titulo: 'Conheça o Leo, a IA que trabalha no WhatsApp da incorporadora', resumo: 'O que o Leo faz, como ele entra na rotina da equipe e por que ele não muda o jeito que vocês trabalham.' },
];
---
<Base>
  <!-- Abertura -->
  <section class="hero">
    <img class="hero-foto" src={foto(FOTOS.predio.id, 2200)} srcset={`${foto(FOTOS.predio.id, 900)} 900w, ${foto(FOTOS.predio.id, 1500)} 1500w, ${foto(FOTOS.predio.id, 2200)} 2200w`} sizes="100vw" alt={FOTOS.predio.alt} fetchpriority="high" />
    <div class="recorte hero-conteudo">
      <h1>A incorporação inteira, em uma plataforma.</h1>
      <p class="hero-sub">Do terreno às chaves: financeiro, obras, compras, vendas e corretores no mesmo sistema. Com o Leo, a inteligência artificial que trabalha no WhatsApp da sua empresa.</p>
      <div class="acoes">
        <a class="botao" href="#contato">Solicite uma demonstração</a>
        <a class="botao contorno" href="/leo">Conheça o Leo</a>
      </div>
      <ul class="selos">
        <li>Feita para incorporadoras e construtoras</li>
        <li>Módulos integrados, do terreno às chaves</li>
        <li>IA que trabalha no WhatsApp</li>
      </ul>
    </div>
  </section>

  <!-- Leo -->
  <section class="leo" id="leo">
    <div class="recorte leo-grade">
      <div class="leo-texto" data-reveal>
        <img class="leo-avatar" src="/marca/leo-avatar.jpg" alt="" width="64" height="64" />
        <h2>Conheça o Leo, a IA do mercado imobiliário.</h2>
        <p>O Leo lê as mensagens dos grupos de WhatsApp da obra, lança as contas, cobra prazos, pede a sua aprovação e avisa a equipe. Você resolve o dia a dia sem abrir o sistema.</p>
        <ul class="lista-check">
          <li>Lê boletos, notas e pedidos enviados no grupo</li>
          <li>Pede aprovação de pagamentos pelo WhatsApp</li>
          <li>Avisa reservas, vendas e prazos da obra</li>
        </ul>
        <a class="botao laranja" href="#contato">Quero ver o Leo em ação</a>
      </div>
      <div class="conversa" data-reveal aria-label="Exemplo de conversa com o Leo, com dados fictícios">
        <p class="conversa-topo"><img src="/marca/leo-avatar.jpg" alt="" width="36" height="36" /><span><strong>Leo</strong><br />Incorion</span></p>
        <div class="msg recebida"><span class="quem">Mestre de obras</span>Chegou o boleto da concretagem da 6ª laje.<span class="anexo">boleto-concreteira.pdf</span></div>
        <div class="msg leo-msg"><span class="quem">Leo</span>Lancei no contas a pagar: Concreteira Vale Forte, R$ 18.400,00, vence 28/10, obra Residencial Aurora.</div>
        <div class="msg leo-msg"><span class="quem">Leo</span>Hoje são 3 contas para pagar, total R$ 37.770. Autoriza?</div>
        <div class="msg enviada">Sim, pode pagar.</div>
        <p class="conversa-nota">Exemplo com dados fictícios.</p>
      </div>
    </div>
  </section>

  <!-- Por que -->
  <section class="porque">
    <div class="recorte">
      <h2 class="centro" data-reveal>Por que a Incorion</h2>
      <div class="porque-grade">
        <article data-reveal>
          <span class="laje" aria-hidden="true"></span>
          <h3>Feita para incorporação</h3>
          <p>Nada de sistema genérico adaptado. SPE, empreendimento, unidade, tabela de vendas e medição de obra já fazem parte da plataforma.</p>
        </article>
        <article data-reveal>
          <span class="laje" aria-hidden="true"></span>
          <h3>Tudo integrado</h3>
          <p>O financeiro conversa com a obra, a obra com as compras e as vendas com os contratos. Um lançamento só, visto por todas as áreas.</p>
        </article>
        <article data-reveal>
          <span class="laje leo" aria-hidden="true"></span>
          <h3>IA no WhatsApp</h3>
          <p>Com o Leo, a equipe de campo continua usando o WhatsApp e as informações chegam organizadas ao sistema.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Plataforma por dentro -->
  <section class="por-dentro" id="plataforma">
    <div class="recorte">
      <div class="cabeca-secao centro-bloco">
        <h2 data-reveal>Conheça a plataforma por dentro.</h2>
        <p data-reveal>Escolha uma área e veja como a Incorion organiza o dia a dia da incorporadora.</p>
      </div>
      <Plataforma />
    </div>
  </section>

  <!-- Perfis -->
  <section class="perfis" id="perfis">
    <div class="recorte">
      <div class="cabeca-secao">
        <h2 data-reveal>Soluções para cada perfil. Qual é o seu?</h2>
      </div>
      <div class="perfis-grade">
        {PERFIS.map((p) => (
          <a class="perfil" href={`/${p.slug}`} data-reveal>
            <img src={foto(FOTOS[p.foto].id, 900, 640)} alt={FOTOS[p.foto].alt} width="900" height="640" loading="lazy" />
            <div class="perfil-texto">
              <h3>{p.nome}</h3>
              <p>{p.resumo}</p>
              <span class="saiba">Saiba mais <svg viewBox="0 0 16 12" aria-hidden="true"><path d="M1 6h13M9 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2"/></svg></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Módulos -->
  <section class="modulos" id="modulos">
    <div class="recorte">
      <div class="cabeca-secao">
        <h2 data-reveal>Do terreno às chaves, um módulo para cada etapa.</h2>
        <p data-reveal>Comece pelo que mais faz falta hoje e ligue os outros quando quiser. Todos conversam entre si.</p>
      </div>
      <ul class="modulos-grade">
        {MODULOS.map((m) => (
          <li data-reveal>
            <a href={`/modulos/${slugModulo(m.nome)}`}>
              <h3>{m.nome}</h3>
              <p>{m.texto}</p>
              <span class="saiba-mod">Saiba mais</span>
            </a>
          </li>
        ))}
        <li class="modulo-leo" data-reveal>
          <a href="/leo">
            <h3>Leo IA</h3>
            <p>O módulo de inteligência artificial que trabalha no WhatsApp. Contratado à parte, junto com a plataforma.</p>
            <span class="saiba-mod">Saiba mais</span>
          </a>
        </li>
      </ul>
      <div class="centro"><a class="botao" href="#contato">Solicite uma demonstração</a></div>
    </div>
  </section>

  <!-- Como funciona -->
  <section class="fluxo">
    <div class="recorte">
      <div class="cabeca-secao">
        <h2 data-reveal>Do grupo da obra ao banco, sem planilha.</h2>
        <p data-reveal>Veja o caminho de um boleto na Incorion.</p>
      </div>
      <ol class="fluxo-grade">
        <li data-reveal>
          <h3>Chega no grupo</h3>
          <p>O mestre de obras manda o boleto no grupo de WhatsApp da obra, como já faz hoje.</p>
        </li>
        <li data-reveal>
          <h3>O Leo lança</h3>
          <p>O Leo lê o boleto e lança no contas a pagar, com fornecedor, valor, vencimento e obra.</p>
        </li>
        <li data-reveal>
          <h3>Você aprova</h3>
          <p>No horário combinado, o Leo manda a lista do dia e você aprova pelo WhatsApp ou pelo sistema.</p>
        </li>
        <li data-reveal>
          <h3>Tudo conferido</h3>
          <p>O pagamento é conferido com o extrato do banco e o comprovante fica guardado na conta.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- Faixa com foto -->
  <section class="faixa">
    <img src={foto(FOTOS.laje.id, 2000, 900)} alt={FOTOS.laje.alt} loading="lazy" width="2000" height="900" />
    <div class="recorte faixa-conteudo" data-reveal>
      <h2>Feita por quem entende de incorporação.</h2>
      <p>Cada tela foi pensada com quem vive o dia a dia de obras, vendas e financeiro. Os termos, os fluxos e os relatórios são os do seu setor.</p>
      <a class="botao claro" href="#contato">Fale com a nossa equipe</a>
    </div>
  </section>

  <!-- Conteúdos -->
  <section class="conteudos">
    <div class="recorte">
      <div class="cabeca-secao linha">
        <div>
          <h2 data-reveal>Mercado, crédito e gestão para quem incorpora</h2>
          <p data-reveal>Conteúdos sobre juros, crédito imobiliário, CRI, fundos e gestão de obras, toda semana no blog.</p>
        </div>
        <a class="link-seta" href="/blog">Ver o blog</a>
      </div>
      <div class="posts-grade">
        {(posts.length > 0 ? posts.map((p) => ({ href: `/blog/${p.id}`, meta: `${p.data.categoria} · ${fmt.format(p.data.data)}`, titulo: p.data.titulo, resumo: p.data.resumo })) : proximos).map((p) => (
          <a class="post" href={p.href} data-reveal>
            <span class="meta">{p.meta}</span>
            <h3>{p.titulo}</h3>
            <p>{p.resumo}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Contato -->
  <section class="contato" id="contato">
    <div class="recorte contato-grade">
      <div class="contato-texto" data-reveal>
        <h2>Solicite uma demonstração.</h2>
        <p>Mostramos a Incorion funcionando com a realidade da sua empresa: suas obras, suas vendas e o seu financeiro.</p>
        <ul class="lista-check claro">
          <li>Conversa com um especialista em incorporação</li>
          <li>Demonstração dos módulos que você escolher</li>
          <li>Proposta de acordo com o tamanho da sua operação</li>
        </ul>
      </div>
      <Demonstracao />
    </div>
  </section>

  <!-- Perguntas frequentes -->
  <section class="faq" id="faq">
    <div class="recorte faq-grade">
      <h2 data-reveal>Perguntas frequentes</h2>
      <div class="faq-lista">
        {FAQ.map(([p, r]) => (
          <details>
            <summary>{p}<svg viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2"/></svg></summary>
            <p>{r}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  section { padding-block: clamp(72px, 9vw, 128px); }
  .centro { text-align: center; }
  .cabeca-secao { max-width: 760px; margin-bottom: 48px; }
  .cabeca-secao h2, .porque h2, .faq h2 { font-size: var(--t-h2); line-height: 1.08; }
  .cabeca-secao p { margin-top: 14px; font-size: var(--t-lead); color: var(--grafite); }
  .cabeca-secao.linha { max-width: none; display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; }

  /* Abertura */
  .hero { background: var(--noite); position: relative; min-height: min(88svh, 820px); display: flex; align-items: center; color: var(--branco); padding-block: 96px; overflow: hidden; isolation: isolate; }
  .hero-foto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .hero::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(14, 26, 51, .94) 0%, rgba(14, 26, 51, .82) 45%, rgba(14, 26, 51, .35) 100%); } /* taste-skill-ignore: escurecimento sob o texto da foto */
  .hero-conteudo { position: relative; }
  .hero h1 { font-size: clamp(2.125rem, 1.2rem + 4.4vw, 5rem); line-height: 1.02; letter-spacing: -0.035em; max-width: 17ch; }
  .hero-sub { margin-top: 24px; font-size: var(--t-lead); line-height: 1.5; max-width: 34em; color: #E2E6EC; }
  .acoes { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  .botao.contorno { background: transparent; color: var(--branco); box-shadow: inset 0 0 0 2px rgba(255, 255, 255, .7); }
  .botao.contorno:hover { background: rgba(255, 255, 255, .1); }
  .selos { list-style: none; margin: 48px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 12px 32px; color: #E2E6EC; font-size: var(--t-pequeno); }
  .selos li { display: flex; align-items: center; gap: 10px; }
  .selos li::before { content: ''; width: 14px; height: 6px; background: var(--cobalto); clip-path: polygon(3px 0, 100% 0, calc(100% - 3px) 100%, 0 100%); }
  .selos li:last-child::before { background: var(--leo); }

  /* Leo */
  .leo { background: var(--concreto); }
  .leo-grade { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(40px, 6vw, 96px); align-items: center; }
  .leo-avatar { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; }
  .leo h2 { margin-top: 20px; font-size: var(--t-h2); line-height: 1.08; max-width: 18ch; }
  .leo-texto > p { margin-top: 18px; font-size: var(--t-lead); color: var(--grafite); max-width: 36em; }
  .lista-check { list-style: none; margin: 24px 0 32px; padding: 0; display: grid; gap: 12px; }
  .lista-check li { display: flex; gap: 12px; align-items: baseline; }
  .lista-check li::before { content: ''; flex: none; width: 16px; height: 7px; background: var(--leo); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); transform: translateY(-2px); }
  .lista-check.claro li::before { background: var(--branco); }
  .botao.laranja { background: var(--leo-texto); }
  .botao.laranja:hover { background: #A8380A; }
  .conversa { background: #E3E7EE; border-radius: 20px; padding: 20px; display: flex; flex-direction: column; gap: 10px; max-width: 460px; justify-self: end; width: 100%; box-shadow: 0 24px 60px rgba(14, 26, 51, .12); }
  .conversa-topo { display: flex; align-items: center; gap: 10px; padding-bottom: 12px; font-size: var(--t-pequeno); line-height: 1.3; }
  .conversa-topo img { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; }
  .msg { background: var(--branco); border-radius: 12px; padding: 10px 14px; max-width: 88%; display: flex; flex-direction: column; gap: 4px; font-size: var(--t-pequeno); line-height: 1.4; }
  .msg .quem { font-weight: 700; font-size: .875rem; color: #17663A; }
  .msg.leo-msg .quem { color: var(--leo-texto); }
  .msg .anexo { margin-top: 4px; background: var(--concreto); border-radius: 8px; padding: 8px 10px; font-weight: 600; }
  .msg.enviada { align-self: flex-end; background: #D9FDD3; }
  .conversa-nota { font-size: .875rem; color: var(--grafite); text-align: center; margin-top: 4px; }

  /* Por que */
  .porque h2 { margin-bottom: 56px; }
  .porque-grade { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .porque article { background: var(--concreto); border-radius: 16px; padding: 32px; }
  .laje { display: block; width: 44px; height: 14px; background: var(--cobalto-texto); clip-path: polygon(8px 0, 100% 0, calc(100% - 8px) 100%, 0 100%); }
  .laje.leo { background: var(--leo); }
  .porque h3, .modulos h3, .fluxo h3, .perfil h3, .post h3 { font: 600 1.375rem/1.2 var(--f-titulo); letter-spacing: -0.02em; }
  .porque h3 { margin-top: 24px; }
  .porque p { margin-top: 10px; color: var(--grafite); }

  /* Plataforma por dentro */
  .por-dentro { background: var(--concreto); }
  .centro-bloco { margin-inline: auto; text-align: center; }

  /* Perfis */
  .perfis { background: var(--branco); }
  .perfis-grade { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .perfil { display: flex; flex-direction: column; text-decoration: none; border-radius: 16px; overflow: hidden; background: var(--noite); color: var(--branco); transition: transform var(--mov); }
  .perfil:hover { transform: translateY(-4px); }
  .perfil img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; background: var(--noite-2); }
  .perfil-texto { padding: 24px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .perfil p { color: var(--suave-escuro); }
  .saiba { margin-top: auto; padding-top: 8px; display: inline-flex; align-items: center; gap: 8px; font-weight: 600; color: var(--branco); }
  .saiba svg { width: 16px; transition: transform var(--mov); }
  .perfil:hover .saiba svg { transform: translateX(4px); }

  /* Módulos */
  .modulos { background: var(--concreto); }
  .modulos-grade { list-style: none; margin: 0 0 48px; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 16px; }
  .modulos-grade li { background: var(--branco); border-radius: 14px; padding: 24px; transition: transform var(--mov), box-shadow var(--mov); }
  .modulos-grade li:hover { transform: translateY(-3px); box-shadow: 0 14px 30px rgba(14, 26, 51, .1); }
  .modulos-grade a { display: flex; flex-direction: column; height: 100%; text-decoration: none; }
  .modulos-grade p { margin-top: 8px; color: var(--grafite); }
  .saiba-mod { margin-top: auto; padding-top: 14px; font-weight: 600; color: var(--cobalto-texto); }
  .modulo-leo .saiba-mod { color: var(--leo); }
  .modulo-leo { background: var(--noite) !important; color: var(--branco); }
  .modulo-leo h3 { color: var(--leo); }
  .modulo-leo p { color: var(--suave-escuro) !important; }

  /* Fluxo */
  .fluxo-grade { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; counter-reset: passo; }
  .fluxo-grade li { position: relative; padding-top: 28px; }
  .fluxo-grade li::before { content: ''; position: absolute; top: 0; left: 0; right: -24px; height: 6px; background: var(--concreto); }
  .fluxo-grade li::after { content: ''; position: absolute; top: -5px; left: 0; width: 44px; height: 16px; background: var(--cobalto-texto); clip-path: polygon(8px 0, 100% 0, calc(100% - 8px) 100%, 0 100%); }
  .fluxo-grade li:nth-child(2)::after { background: var(--leo); }
  .fluxo-grade li:last-child::before { right: 0; }
  .fluxo-grade p { margin-top: 10px; color: var(--grafite); }

  /* Faixa */
  .faixa { background: var(--noite); position: relative; color: var(--branco); padding-block: clamp(96px, 12vw, 160px); overflow: hidden; isolation: isolate; }
  .faixa img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .faixa::before { content: ''; position: absolute; inset: 0; z-index: -1; background: rgba(14, 26, 51, .78); }
  .faixa h2 { font-size: var(--t-h2); line-height: 1.08; max-width: 22ch; }
  .faixa p { margin-top: 18px; font-size: var(--t-lead); max-width: 34em; color: #E2E6EC; }
  .faixa .botao { margin-top: 32px; }

  /* Conteúdos */
  .posts-grade { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .post { text-decoration: none; background: var(--concreto); border-radius: 16px; padding: 28px; display: flex; flex-direction: column; gap: 10px; transition: transform var(--mov); }
  .post:hover { transform: translateY(-3px); }
  .conteudos .cabeca-secao p { margin-top: 12px; font-size: var(--t-lead); color: var(--grafite); }
  .post .meta { font-size: var(--t-pequeno); color: var(--grafite); }
  .post p { color: var(--grafite); }
  .link-seta { font-weight: 600; color: var(--cobalto-texto); }

  /* Contato */
  .contato { background: var(--noite); color: var(--branco); }
  .contato-grade { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(40px, 6vw, 96px); align-items: center; }
  .contato h2 { font-size: var(--t-h2); line-height: 1.08; }
  .contato-texto > p { margin-top: 18px; font-size: var(--t-lead); color: #E2E6EC; max-width: 30em; }

  /* FAQ */
  .faq-grade { display: grid; grid-template-columns: 1fr 2fr; gap: 48px; align-items: start; }
  .faq-lista { display: grid; gap: 12px; }
  details { background: var(--concreto); border-radius: 12px; }
  summary { list-style: none; cursor: pointer; padding: 20px 24px; display: flex; justify-content: space-between; align-items: center; gap: 16px; font-weight: 600; font-size: 1.125rem; }
  summary::-webkit-details-marker { display: none; }
  summary svg { width: 12px; flex: none; transition: transform var(--mov); }
  details[open] summary svg { transform: rotate(180deg); }
  details p { padding: 0 24px 22px; color: var(--grafite); max-width: 60em; }

  /* Entradas ao rolar */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) [data-reveal] { opacity: 0; translate: 0 24px; transition: opacity 650ms cubic-bezier(.2, .7, .2, 1), translate 800ms cubic-bezier(.2, .7, .2, 1); }
    :global(.js) [data-reveal].is-in { opacity: 1; translate: 0 0; }
    .hero-conteudo { animation: sobe 800ms cubic-bezier(.2, .7, .2, 1) both; }
    @keyframes sobe { from { opacity: 0; transform: translateY(20px); } }
  }

  @media (max-width: 960px) {
