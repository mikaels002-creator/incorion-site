---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.rascunho);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const fmt = new Intl.DateTimeFormat('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base titulo={post.data.titulo} descricao={post.data.resumo} tipo="article">
  <article>
    <header class="cabeca">
      <div class="recorte">
        <p class="meta">{post.data.categoria} · {fmt.format(post.data.data)} · por {post.data.autor}</p>
        <h1>{post.data.titulo}</h1>
        <p class="resumo">{post.data.resumo}</p>
      </div>
    </header>
    <div class="recorte corpo"><Content /></div>
    <aside class="recorte chamada">
      <p>Quer usar a Incorion na sua incorporadora?</p>
      <a class="botao" href="/#lista-de-espera">Entrar na lista de espera</a>
    </aside>
  </article>
</Base>

<style>
  .cabeca { background: var(--noite); color: var(--branco); padding-block: 88px 80px; }
  .meta { color: var(--suave-escuro); font-size: var(--t-pequeno); }
  .cabeca h1 { margin-top: 16px; font-size: clamp(2.25rem, 1.2rem + 3.6vw, 4.5rem); max-width: 20ch; }
  .resumo { margin-top: 24px; max-width: 34em; font-size: var(--t-frase); line-height: 1.35; color: var(--suave-escuro); }
  .corpo { padding-block: 72px; max-width: calc(44em + 2 * var(--margem)); margin-left: 0; }
  .corpo :global(p), .corpo :global(li) { font-size: 1.125rem; line-height: 1.65; }
  .corpo :global(p + p), .corpo :global(ul), .corpo :global(ol) { margin-top: 1.1em; }
  .corpo :global(h2) { margin-top: 1.8em; font-size: 2rem; }
  .corpo :global(h2 + p) { margin-top: .7em; }
  .chamada { padding-bottom: var(--secao); display: flex; flex-wrap: wrap; align-items: center; gap: 24px; }
  .chamada p { font-family: var(--f-titulo); font-weight: 600; font-size: 1.75rem; letter-spacing: -0.02em; }
</style>
