---
import Post from '../../components/Post.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.rascunho))
    .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf());
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, outros: posts.filter((p) => p.id !== post.id).slice(0, 3) },
  }));
}
const { post, outros } = Astro.props;
const { Content } = await render(post);
---
<Post post={post} Content={Content} outros={outros} />
