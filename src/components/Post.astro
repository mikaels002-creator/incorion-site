---
// Página de um post do blog. Usada no post publicado e na prévia de aprovação.
import Base from '../layouts/Base.astro';
import Demonstracao from './Demonstracao.astro';
import { capaDoPost, dataDoPost, type Post } from '../lib/blog';

interface Props { post: Post; Content: any; previa?: boolean; outros?: Post[] }
const { post, Content, previa = false, outros = [] } = Astro.props;
const d = post.data;
const fmt = dataDoPost;
const { src: capaSrc, alt: capaAlt } = capaDoPost(post, 900, 700);
const ehLeo = d.autor === 'Leo';
const minutos = Math.max(1, Math.round((post.body ?? '').split(/\s+/).length / 200));
const interesse = d.categoria === 'Corretores' ? 'Corretores' : ehLeo ? 'Leo' : 'Incorion';
---
<Base titulo={d.titulo} descricao={d.resumo} tipo="article" semIndice={previa} imagem={d.capa}>
  {previa && (
    <p class="aviso-previa">Prévia para aprovação. Este post ainda não está publicado e não aparece no Google.</p>
  )}
  <article>
    <header class="cabeca">
      <div class="recorte cabeca-grade">
        <div>
          <p class="trilha"><a href="/">Início</a> / <a href="/blog">Blog</a> / {d.categoria}</p>
          <h1>{d.titulo}</h1>
          <p class="resumo">{d.resumo}</p>
          <div class="autor">
            {ehLeo
              ? <img src="/marca/leo-avatar.jpg" alt="" width="48" height="48" />
              : <img src="/favicon.svg" alt="" width="48" height="48" class="simbolo" />}
            <div>
              <strong>{ehLeo ? 'Leo, a IA da Incorion' : 'Equipe Incorion'}</strong>
              <span><time datetime={d.data.toISOString().slice(0, 10)}>{fmt.format(d.data)}</time> · {minutos} min de leitura</span>
            </div>
          </div>
        </div>
        {d.video
          ? (
            <figure class="capa-video">
              <video class="capa" src={d.video} poster={capaSrc} muted loop playsinline preload="metadata" aria-label={capaAlt} width="1600" height="893" data-capa-video></video>
              <button type="button" class="capa-pausa" data-capa-botao aria-label="Pausar vídeo">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path class="i-pausa" d="M7 5h4v14H7zM13 5h4v14h-4z" /><path class="i-play" d="M8 5v14l11-7z" /></svg>
              </button>
            </figure>
          )
          : <img class="capa" src={capaSrc} alt={capaAlt} width="1600" height="893" loading="eager" />}
      </div>
    </header>

    <div class="recorte corpo-grade">
      <div class="corpo">
        {d.audio && (
          <div class="ouvir">
            <img src="/marca/leo-avatar.jpg" alt="" width="40" height="40" />
            <div>
              <p><strong>Ouça o Leo</strong> resumir este texto</p>
              <audio controls preload="none" src={d.audio} aria-label={`Ouça o Leo resumir: ${d.titulo}`}></audio>
            </div>
          </div>
        )}
        <Content />
      </div>
      <aside class="lateral">
        <div class="cartao">
          <p class="cartao-titulo">Gestão completa para quem incorpora</p>
          <p>Financeiro, obras, compras, vendas e contratos em um só lugar, com o Leo no WhatsApp da sua equipe.</p>
          <a class="botao" href="#contato">Solicite uma demonstração</a>
        </div>
      </aside>
    </div>
  </article>

  {outros.length > 0 && (
    <section class="outros">
      <div class="recorte">
        <h2>Leia também</h2>
        <ul>
          {outros.map((o) => (
            <li><a href={`/blog/${o.id}`}><span>{o.data.categoria}</span><strong>{o.data.titulo}</strong></a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="contato" id="contato">
    <div class="recorte contato-grade">
      <div>
        <h2>Veja a Incorion na sua empresa.</h2>
        <p>Mostramos a plataforma e o Leo com exemplos do dia a dia de uma incorporadora.</p>
      </div>
      <Demonstracao interesse={interesse} />
    </div>
  </section>
</Base>

<script is:inline>
  // Vídeo da capa: só toca sozinho se a pessoa não pediu "reduzir movimento"; sempre tem botão de pausa.
  document.querySelectorAll('[data-capa-video]').forEach((v) => {
    const b = v.parentElement.querySelector('[data-capa-botao]');
    const marcar = () => { const parado = v.paused; b.classList.toggle('parado', parado); b.setAttribute('aria-label', parado ? 'Reproduzir vídeo' : 'Pausar vídeo'); };
    v.addEventListener('play', marcar); v.addEventListener('pause', marcar);
    b.addEventListener('click', () => (v.paused ? v.play() : v.pause()));
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) v.play().catch(marcar); else marcar();
  });
</script>

<style>
  .aviso-previa { background: #FFF4E5; color: #7A3A06; text-align: center; padding: 12px var(--margem); font-weight: 600; font-size: var(--t-pequeno); }
  .cabeca { background: var(--noite); color: var(--branco); padding-block: clamp(56px, 8vw, 96px); }
  .cabeca-grade { display: grid; grid-template-columns: 1.35fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .trilha { font-size: var(--t-pequeno); color: var(--suave-escuro); margin-bottom: 20px; }
  .trilha a { color: inherit; }
  .cabeca h1 { font-size: clamp(2.125rem, 1.2rem + 3vw, 3.75rem); line-height: 1.05; letter-spacing: -0.035em; max-width: 18ch; }
  .resumo { margin-top: 20px; font-size: var(--t-lead); color: #E2E6EC; max-width: 34em; }
  .autor { display: flex; align-items: center; gap: 14px; margin-top: 32px; }
  .autor img { width: 48px; height: 48px; border-radius: 50%; }
  .autor .simbolo { background: var(--branco); padding: 8px; }
  .autor strong { display: block; }
  .autor span { font-size: var(--t-pequeno); color: var(--suave-escuro); }
  .capa { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 14px; background: #1B2A4A; }
  .capa-video { position: relative; margin: 0; }
  .capa-pausa { position: absolute; right: 12px; bottom: 12px; width: 44px; height: 44px; border: 0; border-radius: 50%; background: rgba(14, 26, 51, .72); color: #fff; cursor: pointer; display: grid; place-items: center; }
  .capa-pausa svg { width: 20px; height: 20px; fill: currentColor; }
  .capa-pausa .i-play, .capa-pausa.parado .i-pausa { display: none; }
  .capa-pausa.parado .i-play { display: inline; }

  .corpo-grade { display: grid; grid-template-columns: minmax(0, 44em) 300px; justify-content: space-between; gap: 64px; padding-block: clamp(56px, 8vw, 96px); }
  .corpo :global(p), .corpo :global(li) { font-size: 1.125rem; line-height: 1.7; color: #1F2A3D; }
  .corpo :global(p + p), .corpo :global(ul), .corpo :global(ol) { margin-top: 1.1em; }
  .corpo :global(h2) { margin-top: 1.8em; font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); line-height: 1.15; }
  .corpo :global(h2 + p) { margin-top: .7em; }
  .corpo :global(a) { color: var(--cobalto-texto); }
  .corpo :global(strong) { color: var(--noite); }
  .corpo :global(img) { width: 100%; height: auto; border-radius: 12px; margin-block: 1.6em .4em; }
  .corpo :global(img + em), .corpo :global(p:has(img) + p > em:only-child) { font-size: var(--t-pequeno); }
  .ouvir { display: flex; gap: 14px; align-items: center; background: #FFF4EC; border-radius: 12px; padding: 14px 18px; margin-bottom: 2em; }
  .ouvir img { width: 40px; height: 40px; border-radius: 50%; flex: none; }
  .ouvir div { flex: 1; min-width: 0; }
  .ouvir p { font-size: var(--t-pequeno) !important; margin: 0 0 6px !important; }
  .ouvir audio { width: 100%; height: 36px; }
  .lateral { position: relative; }
  .cartao { position: sticky; top: 104px; background: var(--concreto); border-radius: 14px; padding: 24px; display: grid; gap: 14px; }
  .cartao-titulo { font: 600 1.25rem/1.2 var(--f-titulo); letter-spacing: -0.02em; }
  .cartao p:not(.cartao-titulo) { color: var(--grafite); font-size: var(--t-pequeno); }

  .outros { background: var(--concreto); padding-block: 72px; }
  .outros h2 { font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); margin-bottom: 24px; }
  .outros ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 12px; }
  .outros a { display: flex; flex-direction: column; gap: 8px; height: 100%; text-decoration: none; background: var(--branco); border-radius: 12px; padding: 22px; transition: transform var(--mov); }
  .outros a:hover { transform: translateY(-3px); }
  .outros span { font-size: var(--t-pequeno); color: var(--cobalto-texto); font-weight: 600; }
  .outros strong { font: 600 1.25rem/1.25 var(--f-titulo); }

  .contato { background: var(--noite); color: var(--branco); padding-block: clamp(72px, 9vw, 120px); }
  .contato-grade { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(40px, 6vw, 96px); align-items: center; }
  .contato h2 { font-size: var(--t-h2); line-height: 1.08; }
  .contato p { margin-top: 18px; font-size: var(--t-lead); color: #E2E6EC; max-width: 30em; }

  @media (max-width: 960px) {
    .cabeca-grade, .corpo-grade, .contato-grade { grid-template-columns: 1fr; }
    .capa { aspect-ratio: 16 / 9; }
    .lateral { display: none; }
  }
</style>
